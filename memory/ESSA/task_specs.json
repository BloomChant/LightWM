{
  "__comment__": "Task-family specs for ESSA. MVP: only pick_and_place_simple. JSON only (no comments).",
  "pick_and_place_simple": {
    "__comment__": "Take <target_object> and move it to <target_receptacle>. Let the model judge success based on observation.",
    "task_state_schema": {
      "task_type": "pick_and_place_simple",
      "goal_template": "take <target_object> and move it to <target_receptacle>",
      "success_precondition_template": [
        "obj_at_recep(<target_object>, <target_receptacle>)"
      ],
      "fields": {
        "goal": "string",
        "target_object": "string (surface form, e.g. apple)",
        "target_receptacle": "string (surface form, e.g. desk)",
        "target_receptacle_id": "string|null (a concrete destination id, e.g. 'desk 1'; best-effort inferred from target_receptacle + all_receptacles; deterministic: choose the smallest number)",
        "all_receptacles": "list[string] (extract from initial observation: receptacles/surfaces/containers the agent can go to/open)",
        "agent_position": "string|null (best effort, from observation)",
        "inventory": "list[string] (update using observation after inventory/take/move)",
        "target_object_location": "string|null (e.g. 'apple 1 at desk 2' or 'apple 1 in drawer 2')",
        "moved_target_object_location": "list[string] (append-only history of confirmed move outcomes, e.g. ['mug 1 at desk 2'])"
      }
    },
    "init_rules": [
      "goal: MUST be a concise normalized string (e.g., \"take <obj> and move it to <recep>\").",
      "target_object / target_receptacle: best-effort infer from GOAL.",
      "target_receptacle_id: best-effort infer from target_receptacle + all_receptacles; deterministic: choose the smallest number.",
      "all_receptacles: MUST include ALL receptacle/surface/container ids mentioned in INITIAL_OBSERVATION \"you see ...\" list.",
      "all_receptacles: MUST NOT filter to only the target receptacle type (e.g., NOT only \"cabinet *\").",
      "all_receptacles: Keep concrete ids (e.g., \"drawer 2\", \"countertop 1\"). Preserve order if possible.",
      "all_receptacles: If too many, keep up to 80."
    ],
    "base_subtask_sequence": [
      {
        "name": "searchObject",
        "subtask_type": "SEARCH_OBJECT",
        "signature": "searchObject(<target_object>, <all_receptacles>) -> <target_object_location>",
        "expects": [
          "target_object",
          "all_receptacles"
        ],
        "produces": [
          "target_object_location"
        ]
      },
      {
        "name": "takeObject",
        "subtask_type": "TAKE_OBJECT",
        "signature": "takeObject(<target_object>, <target_object_location>)",
        "expects": [
          "target_object",
          "target_object_location"
        ],
        "produces": [
          "inventory"
        ]
      },
      {
        "name": "moveObjectToRecep",
        "subtask_type": "MOVE_OBJECT_TO_RECEP",
        "signature": "moveObjectToRecep(<target_object>, <target_receptacle>) -> <moved_target_object_location>",
        "expects": [
          "target_object",
          "target_receptacle",
          "inventory"
        ],
        "produces": [
          "moved_target_object_location"
        ]
      }
    ]
  },
  "look_at_obj_in_light": {
    "task_state_schema": {
      "fields": {
