        ],
        "produces": [
          "inventory"
        ]
      },
      {
        "name": "useLamp",
        "subtask_type": "USE_LAMP",
        "expects": [
          "lamp_object",
          "lamp_object_location",
          "inventory"
        ],
        "produces": [
          "lamp_status"
        ]
      }
    ]
  },
