        "lamp_object_location": "string|null",
        "lamp_status": "string|null"
      }
    },
    "init_rules": [
      "goal := \"look_at_obj_in_light\".",
      "target_object := \"\".",
      "lamp_object := \"desklamp\".",
      "all_receptacles := [\"desk 1\", \"bed 1\"].",
      "agent_position := null.",
      "inventory := [].",
      "target_object_location := null.",
      "lamp_object_location := null.",
      "lamp_status := null."
